# Chorus configuration — all options are read from the environment.
# Copy to `.env` and load it however you like:
#   • Node 20.6+:           node --env-file=.env server.js
#   • shell:                export $(grep -v '^#' .env | xargs) && node server.js
#   • your host's UI:       Fly secrets / Render env vars / docker -e …
# None of these are required — the server runs with sane defaults.

# ── Login (ON by default) ────────────────────────────────────────────────────
# Set your own credentials (recommended for anything real). If you leave the
# password unset, a random one is generated and printed to stdout on boot.
CHORUS_USER=admin
CHORUS_PASSWORD=change-me-to-a-strong-passphrase
# Open, no-login sandbox instead? Uncomment:
# CHORUS_NO_AUTH=1

# ── Network ──────────────────────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1            # use 0.0.0.0 to accept LAN / tunnel / container traffic
# Behind a reverse proxy (Fly / Render / nginx / Cloudflare)? Set this so the
# login rate-limiter sees the real client IP. Value: 1 (one hop), a hop count, or true.
# TRUST_PROXY=1

# ── Storage ──────────────────────────────────────────────────────────────────
CHORUS_DB=./chorus.db    # SQLite file path (put it on a persistent volume in prod)

# ── Capacity guardrails ──────────────────────────────────────────────────────
MAX_TOPICS=300
MAX_BLOCKS_PER_TOPIC=1000
